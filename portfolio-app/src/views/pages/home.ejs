<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="Electrical engineering, research, software development and data analytics portfolio."><title><%= title %> — Harrison Ogheneyoma Onigba</title><link rel="stylesheet" href="/css/app.css"></head>
<body><header class="site-header"><a class="brand" href="/">Harrison <span>Onigba</span></a><nav><a href="#about">About</a><a href="#projects">Projects</a><a href="#contact">Contact</a><a href="/auth/login">Admin</a></nav></header>
<main><section class="hero"><div><p class="eyebrow">ENGINEERING · RESEARCH · TECHNOLOGY</p><h1>Harrison<br><span>Ogheneyoma Onigba.</span></h1><p class="lead">I connect engineering, research and software to turn practical challenges into useful solutions.</p><p>My work spans electrical and power systems, embedded technology, multidisciplinary research, backend development and data analytics.</p><a class="button" href="#projects">Explore my work</a></div><img src="/images/portfolio-hero.svg" alt="Illustration of power systems, embedded electronics, software and data analytics"></section>
<section class="section" id="about"><p class="eyebrow">ABOUT</p><h2>Practical thinking across disciplines.</h2><p>My background combines an HND in Electrical and Electronic Engineering Technology, specialising in Power and Machines, with industrial exposure, collaborative research and ongoing software and data-analysis projects.</p></section>
<section class="section" id="projects"><p class="eyebrow">SELECTED WORK</p><h2>Projects and research</h2><div class="cards"><% if (!projects.length) { %><p>Project details are being prepared. Please check back soon.</p><% } %><% projects.forEach(project => { %><article class="project-card"><p class="eyebrow"><%= project.category %></p><h3><%= project.title %></h3><p><%= project.summary %></p><% if (project.repositoryUrl) { %><a href="<%= project.repositoryUrl %>" target="_blank" rel="noopener noreferrer">View repository ↗</a><% } %></article><% }) %></div></section>
<section class="section contact" id="contact"><p class="eyebrow">CONTACT</p><h2>Have a project or opportunity in mind?</h2><% if (typeof sent !== "undefined" && sent) { %><p class="success">Your message has been received. Thank you.</p><% } %><form method="post" action="/contact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" maxlength="100" required></label><label>Email<input type="email" name="email" maxlength="254" required></label><label>Subject<input name="subject" maxlength="150"></label><label>Message<textarea name="message" rows="6" maxlength="5000" required></textarea></label><button type="submit">Send message</button></form></section></main>
<footer>© <%= new Date().getFullYear() %> Harrison Ogheneyoma Onigba · Engineering · Research · Technology</footer></body></html>