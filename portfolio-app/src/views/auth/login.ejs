<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head>
<body><main class="auth-card"><p class="eyebrow">PORTFOLIO ADMIN</p><h1>Sign in</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/auth/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email<input type="email" name="email" autocomplete="username" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button type="submit">Sign in</button></form>
<a href="/">Back to portfolio</a></main></body></html>