<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head>
<body><header class="topbar"><a href="/admin">Dashboard</a><form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary">Sign out</button></form></header><main class="container"><h1>Contact messages</h1>
<% if (!messages.length) { %><p>No messages yet.</p><% } %><% messages.forEach(message => { %><article class="message"><p><strong><%= message.name %></strong> · <%= message.email %> · <%= message.createdAt.toLocaleString() %></p><h2><%= message.subject || "No subject" %></h2><p><%= message.message %></p><p>Status: <%= message.read ? "Read" : "Unread" %></p><div class="actions"><% if (!message.read) { %><form method="post" action="/admin/messages/<%= message.id %><input type="hidden" name="_csrf" value="<%= csrfToken %>">/read"><button>Mark as read</button></form><% } %><form method="post" action="/admin/messages/<%= message.id %><input type="hidden" name="_csrf" value="<%= csrfToken %>">/delete" onsubmit="return confirm('Delete this message?')"><button class="danger">Delete</button></form></div></article><% }) %></main></body></html>