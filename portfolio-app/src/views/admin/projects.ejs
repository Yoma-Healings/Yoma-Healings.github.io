<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head><body><header class="topbar"><a href="/admin">Dashboard</a><form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary">Sign out</button></form></header><main class="container"><div class="actions"><h1>Manage projects</h1><a class="button" href="/admin/projects/new">Add project</a></div><% if (!projects.length) { %><p>No projects yet. Add your first project.</p><% } %><% projects.forEach(project => { %><article class="message"><p class="eyebrow"><%= project.category %> · <%= project.published ? "PUBLISHED" : "DRAFT" %><%= project.featured ? " · FEATURED" : "" %></p><h2><%= project.title %></h2><p><%= project.summary %></p><div class="actions"><a class="button" href="/admin/projects/<%= project.id %>/edit">Edit</a><form method="post" action="/admin/projects/<%= project.id %>/delete" onsubmit="return confirm('Permanently delete this project?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">Delete</button></form></div></article><% }) %></main></body></html>