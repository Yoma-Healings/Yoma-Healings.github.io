<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/app.css"></head><body><header class="topbar"><a href="/admin/projects">← Projects</a><form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary">Sign out</button></form></header><main class="container"><h1><%= title %></h1><% if (error) { %><p class="error"><%= error %></p><% } %><form class="contact" method="post" action="<%= project ? '/admin/projects/' + project.id : '/admin/projects' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Project title<input name="title" maxlength="150" required value="<%= project?.title || '' %>"></label><label>Category<input name="category" maxlength="80" required value="<%= project?.category || '' %>"></label><label>Short summary<textarea name="summary" maxlength="300" required rows="2"><%= project?.summary || '' %></textarea></label><label>Description<textarea name="description" maxlength="12000" required rows="8"><%= project?.description || '' %></textarea></label><label>Technologies (comma separated)<input name="technologies" value="<%= Array.isArray(project?.technologies) ? project.technologies.join(', ') : (project?.technologies || '') %>"></label><label>Image URL (HTTPS)<input type="url" name="imageUrl" value="<%= project?.imageUrl || '' %>"></label><label>Repository URL (HTTPS)<input type="url" name="repositoryUrl" value="<%= project?.repositoryUrl || '' %>"></label><label>Live project URL (HTTPS)<input type="url" name="liveUrl" value="<%= project?.liveUrl || '' %>"></label><label><input type="checkbox" name="featured" <%= project?.featured ? 'checked' : '' %>> Feature this project</label><label><input type="checkbox" name="published" <%= project?.published ? 'checked' : '' %>> Publish on public homepage</label><button type="submit">Save project</button></form></main></body></html>